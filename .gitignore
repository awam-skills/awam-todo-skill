# awam-todo 本地数据（按设计不纳入 Git 管理）
# 存储目录：按日期划分的待办文件
storage/
# 索引文件：由脚本自动维护
index.json
# 环境信息：由 init 命令按本机探测生成（跨机器不同）
env.json
# 会话记忆：本机工作日志，不随技能分发
.workbuddy/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/

# 工具与测试缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# web 前端运行时日志
web/*.log
